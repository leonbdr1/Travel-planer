{
  "$id": "reiseplaner.catalog-regions/1.1.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "countryCode",
    "themes"
  ],
  "properties": {
    "countryCode": {
      "type": "string",
      "enum": [
        "DE",
        "AT",
        "CH",
        "IT-BZ"
      ]
    },
    "subdivision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "wandern",
          "bergpanorama",
          "seen",
          "natur_ruhe",
          "radfahren",
          "wellness",
          "wintersport",
          "staedte_kultur",
          "wein_kulinarik",
          "familie",
          "shopping",
          "strand"
        ]
      }
    }
  }
}
