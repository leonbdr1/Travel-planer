{
  "$id": "reiseplaner.review-verify/1.0.0/input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hotelName",
    "snippets"
  ],
  "properties": {
    "hotelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "snippets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topicHint",
          "date",
          "lang",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "topicHint": {
            "type": "string",
            "enum": [
              "sauberkeit",
              "schimmel",
              "ungeziefer",
              "laerm",
              "geruch",
              "zustand",
              "abweichung_beschreibung"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "lang": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    }
  }
}
