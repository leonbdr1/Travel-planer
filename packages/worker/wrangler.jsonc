// Worker configuration (architektur.md 12). Contains no product values:
// the worker name is derived from product.config.yaml by the Vite plugin
// (packages/web/vite.config.ts) and the deploy step fills the
// __REISEPLANER_…__ placeholders per environment ("TENANT GUARD").
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./src/index.ts",
  // Newest date supported by the workerd bundled with the Vitest pool;
  // implies nodejs_compat by default, the flag is kept explicit.
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54329/postgres"
    }
  ],
  // Combination search (architektur.md 6.4).
  "workflows": [{ "name": "app-search", "binding": "SEARCH_WORKFLOW", "class_name": "SearchWorkflow" }],
  "vars": {
    "APP_ENV": "dev",
    "PROVIDERS_MODE": "fake",
    "LLM_ENABLED": "true",
    "LITEAPI_BASE_URL": "https://api.liteapi.travel/v3.0",
    "LITEAPI_BOOK_BASE_URL": "https://book.liteapi.travel/v3.0",
    "LITEAPI_PAYMENT_MODE": "sandbox",
    "ORS_BASE_URL": "https://api.heigit.org/openrouteservice",
    // Fake mode only: simulated latency and every n-th rate call failing
    // persistently, so progress and "keine Daten" cells are visible locally.
    "FAKE_LATENCY_MS": "150",
    "FAKE_FAIL_EVERY": "40",
    // Dev only: show the AI-drafted catalog before its editorial approval (BG-11).
    "CATALOG_ALLOW_DRAFTS": "true"
  },
  "env": {
    "staging": {
      "name": "__REISEPLANER_WORKER_NAME__-staging",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "__REISEPLANER_HYPERDRIVE_ID_STAGING__" }],
      "workflows": [{ "name": "__REISEPLANER_WORKER_NAME__-staging-search", "binding": "SEARCH_WORKFLOW", "class_name": "SearchWorkflow" }],
      "vars": {
        "APP_ENV": "staging",
        "PROVIDERS_MODE": "sandbox",
        "LLM_ENABLED": "true",
        "LITEAPI_BASE_URL": "https://api.liteapi.travel/v3.0",
        "LITEAPI_BOOK_BASE_URL": "https://book.liteapi.travel/v3.0",
        "LITEAPI_PAYMENT_MODE": "sandbox",
        "ORS_BASE_URL": "https://api.heigit.org/openrouteservice"
      }
    },
    "production": {
      "name": "__REISEPLANER_WORKER_NAME__",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "__REISEPLANER_HYPERDRIVE_ID_PRODUCTION__" }],
      "workflows": [{ "name": "__REISEPLANER_WORKER_NAME__-search", "binding": "SEARCH_WORKFLOW", "class_name": "SearchWorkflow" }],
      "vars": {
        "APP_ENV": "production",
        "PROVIDERS_MODE": "live",
        "LLM_ENABLED": "true",
        "LITEAPI_BASE_URL": "https://api.liteapi.travel/v3.0",
        "LITEAPI_BOOK_BASE_URL": "https://book.liteapi.travel/v3.0",
        "LITEAPI_PAYMENT_MODE": "live",
        "ORS_BASE_URL": "https://api.heigit.org/openrouteservice"
      }
    }
  }
}
