// Worker configuration (architektur.md 12). Contains no product values:
// the worker name is derived from product.config.yaml by the Vite plugin
// (packages/web/vite.config.ts) and the deploy step fills the
// __REISEPLANER_…__ placeholders per environment ("TENANT GUARD").
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./src/index.ts",
  // Newest date supported by the workerd bundled with the Vitest pool;
  // implies nodejs_compat by default, the flag is kept explicit.
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54329/postgres"
    }
  ],
  // Combination search (architektur.md 6.4).
  "workflows": [{ "name": "app-search", "binding": "SEARCH_WORKFLOW", "class_name": "SearchWorkflow" }],
  // Maintenance jobs (architektur.md 6.12); the schedules are mirrored in src/cron.ts.
  "triggers": { "crons": ["*/10 * * * *", "0 * * * *", "30 3 * * *"] },
  "vars": {
    "APP_ENV": "dev",
    "PROVIDERS_MODE": "fake",
    "LLM_ENABLED": "true",
    "LITEAPI_BASE_URL": "https://api.liteapi.travel/v3.0",
    "LITEAPI_BOOK_BASE_URL": "https://book.liteapi.travel/v3.0",
    "LITEAPI_PAYMENT_MODE": "sandbox",
    "ORS_BASE_URL": "https://api.heigit.org/openrouteservice",
    "OVERPASS_BASE_URL": "https://overpass-api.de/api/interpreter",
    // Fake mode only: simulated latency and every n-th rate call failing
    // persistently, so progress and "keine Daten" cells are visible locally.
    "FAKE_LATENCY_MS": "150",
    "FAKE_FAIL_EVERY": "40",
    // Dev only: show the AI-drafted catalog before its editorial approval (BG-11).
    "CATALOG_ALLOW_DRAFTS": "true",
    // Emergency brake for the booking flow (umsetzungsplan M8 rollback).
    "BOOKING_ENABLED": "true"
  },
  "env": {
    // `npm run serve` (scripts/serve.ts): built SPA and Worker on one local port behind the site
    // gate, meant to be put on the internet through a tunnel from the developer's machine.
    // Providers follow packages/worker/.dev.vars (Testbetrieb) as in `npm run dev`.
    "serve": {
      "name": "app-serve",
      "assets": {
        "directory": "../web/dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
        "binding": "ASSETS"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54329/postgres"
        }
      ],
      "workflows": [{ "name": "app-serve-search", "binding": "SEARCH_WORKFLOW", "class_name": "SearchWorkflow" }],
      "vars": {
        "APP_ENV": "dev",
        "PROVIDERS_MODE": "fake",
        "LLM_ENABLED": "true",
        "SITE_GATE": "password",
        "LITEAPI_BASE_URL": "https://api.liteapi.travel/v3.0",
        "LITEAPI_BOOK_BASE_URL": "https://book.liteapi.travel/v3.0",
        "LITEAPI_PAYMENT_MODE": "sandbox",
        "ORS_BASE_URL": "https://api.heigit.org/openrouteservice",
        "OVERPASS_BASE_URL": "https://overpass-api.de/api/interpreter",
        "FAKE_LATENCY_MS": "150",
        "FAKE_FAIL_EVERY": "40",
        "CATALOG_ALLOW_DRAFTS": "true",
        "BOOKING_ENABLED": "true"
      }
    },
    "staging": {
      "name": "__REISEPLANER_WORKER_NAME__-staging",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "__REISEPLANER_HYPERDRIVE_ID_STAGING__" }],
      "workflows": [{ "name": "__REISEPLANER_WORKER_NAME__-staging-search", "binding": "SEARCH_WORKFLOW", "class_name": "SearchWorkflow" }],
      // The site gate (src/gate.ts) must see every request, so the Worker runs before the assets.
      "assets": { "not_found_handling": "single-page-application", "run_worker_first": true },
      "vars": {
        "APP_ENV": "staging",
        // Password gate until the product goes public (BEN-GATE to switch off).
        "SITE_GATE": "password",
        "PROVIDERS_MODE": "sandbox",
        "LLM_ENABLED": "true",
        "LITEAPI_BASE_URL": "https://api.liteapi.travel/v3.0",
        "LITEAPI_BOOK_BASE_URL": "https://book.liteapi.travel/v3.0",
        "LITEAPI_PAYMENT_MODE": "sandbox",
        "ORS_BASE_URL": "https://api.heigit.org/openrouteservice",
        "OVERPASS_BASE_URL": "https://overpass-api.de/api/interpreter",
        "BOOKING_ENABLED": "true"
      }
    },
    "production": {
      "name": "__REISEPLANER_WORKER_NAME__",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "__REISEPLANER_HYPERDRIVE_ID_PRODUCTION__" }],
      "workflows": [{ "name": "__REISEPLANER_WORKER_NAME__-search", "binding": "SEARCH_WORKFLOW", "class_name": "SearchWorkflow" }],
      // The site gate (src/gate.ts) must see every request, so the Worker runs before the assets.
      "assets": { "not_found_handling": "single-page-application", "run_worker_first": true },
      "vars": {
        "APP_ENV": "production",
        // Password gate until the product goes public (BEN-GATE to switch off).
        "SITE_GATE": "password",
        "PROVIDERS_MODE": "live",
        "LLM_ENABLED": "true",
        "LITEAPI_BASE_URL": "https://api.liteapi.travel/v3.0",
        "LITEAPI_BOOK_BASE_URL": "https://book.liteapi.travel/v3.0",
        "LITEAPI_PAYMENT_MODE": "live",
        "ORS_BASE_URL": "https://api.heigit.org/openrouteservice",
        "OVERPASS_BASE_URL": "https://overpass-api.de/api/interpreter",
        "BOOKING_ENABLED": "true"
      }
    }
  }
}
