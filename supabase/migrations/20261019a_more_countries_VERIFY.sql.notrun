-- Verification for 20261019a_more_countries: the country checks list the
-- additional European countries, and row security is still enabled.
SELECT conrelid::regclass AS tbl, conname, pg_get_constraintdef(oid) AS def
  FROM pg_constraint
 WHERE conrelid IN ('app.geo_localities'::regclass, 'app.regions'::regclass, 'app.places'::regclass) AND contype = 'c'
 ORDER BY 1, 2;
SELECT tablename, rowsecurity FROM pg_tables WHERE schemaname = 'app' AND tablename IN ('geo_localities', 'regions', 'places');
